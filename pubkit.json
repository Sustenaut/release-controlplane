{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "make venv node",
      "test": "make functional",
      "shellcheck": "with-secrets scripts/*.sh"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "github_app": {
    "id": {
      "from": "github-release-reader-id",
      "to": "RELEASE_READER_APP_ID"
    },
    "installation_id": {
      "from": "github-release-reader-installation-id",
      "to": "RELEASE_READER_APP_INSTALLATION_ID"
    },
    "key": {
      "from": "github-release-reader-key",
      "to": "RELEASE_READER_APP_KEY"
    }
  },
  "secrets": [
    {
      "from": "sustenaut-nightly-app-id",
      "to": "NIGHTLY_APP_ID",
      "kind": "variable"
    },
    {
      "from": "sustenaut-nightly-app-key",
      "to": "NIGHTLY_APP_KEY",
      "kind": "secret"
    },
    {
      "from": "slack-bot-token",
      "to": "SUSTENAUT_SLACK_BOT_TOKEN",
      "kind": "secret"
    },
    {
      "from": "slack-dm-user-id",
      "to": "SLACK_DM_USER_ID",
      "kind": "secret"
    }
  ],
  "deploy": {
    "providers": [{"distribution": "pubdeploy", "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.3.0/pubdeploy-0.3.0-py3-none-any.whl", "sha256": "f569e8cbb50e869b8e856bd15d178ccacf2c62e40b1cf278fde807847706fb07"}, {"distribution": "pubsec", "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.1.2/pubsec-0.1.2-py3-none-any.whl", "sha256": "88a68ffd252b49289ae02d0a9f629f3e0f0832c921cb8ee0f1301f958527de17"}],
    "namespace": "release",
    "host": "release.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_RELEASE",
    "needs": [
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-id",
        "secret": {
          "name": "release-secrets",
          "key": "reader-app-id"
        },
        "unit": "release"
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-key",
        "secret": {
          "name": "release-secrets",
          "key": "reader-app-key"
        },
        "unit": "release"
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-reader-installation-id",
        "secret": {
          "name": "release-secrets",
          "key": "reader-installation-id"
        },
        "unit": "release"
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-writer-id",
        "secret": {
          "name": "release-secrets",
          "key": "writer-app-id"
        },
        "unit": "release"
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-writer-key",
        "secret": {
          "name": "release-secrets",
          "key": "writer-app-key"
        },
        "unit": "release"
      },
      {
        "type": "bitwarden.secret",
        "name": "github-release-writer-installation-id",
        "secret": {
          "name": "release-secrets",
          "key": "writer-installation-id"
        },
        "unit": "release"
      },
      {
        "type": "bitwarden.generated",
        "name": "release-cookie-secret",
        "shape": "oauth2-proxy-cookie",
        "secret": {
          "name": "release-secrets",
          "key": "cookie-secret"
        },
        "unit": "release"
      },
      {
        "type": "auth.sign-in-client",
        "realm": "team",
        "role": "release",
        "auth": "https://auth.sustenaut.eu/realms/team",
        "domain": "sustenaut.eu",
        "host": "release.sustenaut.eu",
        "state": "/root/.config/sustenaut-auth/team-sustenaut.eu",
        "client_name": "sustenaut.eu team sites",
        "register_app": "../auth/register-app.py",
        "approvals": "../shared-infra/infra/auth-approvals.json",
        "access": "https://auth.sustenaut.eu/realms/team/access",
        "secret": {
          "name": "release-oidc"
        },
        "unit": "release"
      },
      {
        "type": "k8s.manifests",
        "path": "k8s/admin/network-policy.yaml",
        "unit": "release"
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "release-sustenaut",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:release/app"
        ],
        "write": [
          "github:Sustenaut/release-controlplane@refs/heads/main"
        ],
        "private": true,
        "heads": true,
        "unit": "release"
      },
      {
        "type": "storage.tenant",
        "name": "calls-release-controlplane",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "write": [
          "k8s:release/app",
          "k8s:release-schryer/app"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "storage.tenant",
        "name": "pubkit-checks",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "write": [
          "github:Sustenaut/release-controlplane@refs/heads/main"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/integrations",
        "variable": "INGEST_PUBKIT_CHECKS",
        "path": "/tenant",
        "value": "pubkit-checks"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/integrations",
        "variable": "INGEST_PUBKIT_CHECKS",
        "path": "/dataset",
        "value": "platform"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/integrations",
        "variable": "INGEST_DATASETS",
        "path": "/release-controlplane",
        "value": "calls_release_controlplane"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/observability",
        "variable": "OBSERVABILITY_SENDERS",
        "path": "/release_controlplane/app",
        "value": "always"
      },
      {
        "type": "storage.tenant",
        "name": "release-schryer",
        "unit": "release-schryer",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:release-schryer/app"
        ],
        "write": [
          "github:schryer/release-controlplane@refs/heads/main"
        ],
        "private": true,
        "heads": true
      },
      {
        "type": "k8s.secret",
        "name": "release-secrets",
        "unit": "release-schryer",
        "keys": [
          "reader-app-id",
          "reader-app-key",
          "reader-installation-id",
          "writer-app-id",
          "writer-app-key",
          "writer-installation-id",
          "cookie-secret",
          "allowed-emails",
          "allowed-emails-file"
        ]
      },
      {
        "type": "k8s.secret",
        "name": "release-oidc",
        "unit": "release-schryer",
        "keys": [
          "client-id",
          "client-secret"
        ]
      }
    ],
    "units": {
      "release-schryer": {
        "namespace": "release-schryer",
        "overlay": "k8s-schryer",
        "gate": "DEPLOY_SCHRYER",
        "host": "release.schryer.eu"
      }
    }
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
