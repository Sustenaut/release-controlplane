{
  "comment": "What scripts/push-secrets.sh sends from Bitwarden to GitHub. name: the secret's exact name in the Bitwarden project with-secrets.json names. kind: variable for what isn't secret (ids), secret for a key. github: its name on GitHub. to: each repository, or repository#environment. check: id (digits) or key (a PEM private key). optional: a name that may be missing, which is reported and skipped. Each app's installation id is its Sustenaut installation's; schryer's has its own name. The state writer can change the state repositories, so its key is only in the server environment, which only main may use: a pull request's workflow can't read it.",
  "environments": {
    "Sustenaut/release-controlplane#server": {
      "branch": "main"
    }
  },
  "secrets": [
    {
      "name": "github-release-reader-id",
      "kind": "variable",
      "check": "id",
      "github": "RELEASE_READER_APP_ID",
      "to": [
        "Sustenaut/release-state",
        "schryer/release-state",
        "Sustenaut/release-controlplane"
      ]
    },
    {
      "name": "github-release-reader-key",
      "kind": "secret",
      "check": "key",
      "github": "RELEASE_READER_APP_KEY",
      "to": [
        "Sustenaut/release-state",
        "schryer/release-state",
        "Sustenaut/release-controlplane"
      ]
    },
    {
      "name": "github-release-reader-installation-id",
      "kind": "variable",
      "check": "id",
      "github": "RELEASE_READER_INSTALLATION_ID_SUSTENAUT",
      "to": [
        "Sustenaut/release-state",
        "Sustenaut/release-controlplane"
      ]
    },
    {
      "name": "github-release-reader-installation-id-schryer",
      "kind": "variable",
      "check": "id",
      "github": "RELEASE_READER_INSTALLATION_ID_SCHRYER",
      "to": [
        "schryer/release-state",
        "Sustenaut/release-controlplane"
      ],
      "optional": true
    },
    {
      "name": "github-release-writer-id",
      "kind": "variable",
      "check": "id",
      "github": "RELEASE_STATE_WRITER_APP_ID",
      "to": [
        "Sustenaut/release-controlplane#server"
      ]
    },
    {
      "name": "github-release-writer-key",
      "kind": "secret",
      "check": "key",
      "github": "RELEASE_STATE_WRITER_APP_KEY",
      "to": [
        "Sustenaut/release-controlplane#server"
      ]
    },
    {
      "name": "github-release-writer-installation-id",
      "kind": "variable",
      "check": "id",
      "github": "RELEASE_STATE_WRITER_INSTALLATION_ID_SUSTENAUT",
      "to": [
        "Sustenaut/release-controlplane#server"
      ]
    },
    {
      "name": "github-release-writer-installation-id-schryer",
      "kind": "variable",
      "check": "id",
      "github": "RELEASE_STATE_WRITER_INSTALLATION_ID_SCHRYER",
      "to": [
        "Sustenaut/release-controlplane#server"
      ],
      "optional": true
    }
  ]
}
