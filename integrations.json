{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets",
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.actions-oidc",
      "paths": [
        ".github/workflows/hourly-board.yml",
        "scripts/publish-board.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/fleet-nightly.yml",
        ".github/workflows/hourly-board.yml",
        "app/config.js",
        "app/test/**",
        "pubkit.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/workflows/fleet-nightly.yml",
        ".github/workflows/hourly-board.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "slack.post",
      "paths": [
        ".github/workflows/fleet-nightly.yml",
        "pubkit.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/hourly-board.yml"
      ],
      "mode": "required"
    }
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes and test data"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ]
}
