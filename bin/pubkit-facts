#!/usr/bin/env python3
"""The platform's nightly checks of each repository against pubkit, as facts:

    bin/pubkit-facts state.json --url https://storage.sustenaut.eu --tenant pubkit-checks
    bin/pubkit-facts state.json --out checks.avro          # the file alone, sent nowhere

For each repository state.json puts on the board it reads, as the token in GH_TOKEN
allows, two things, and records both whatever they show, passes as well as failures:

- pin: the pubkit its tests/requirements-pubkit.txt pins, against pubkit's releases. It
  passes on the latest, is "behind" while the first release after its pin is under
  GRACE_DAYS old (the nightly and the bump round have not had their turn yet), and
  fails once that release is older: a repository left behind, not a release day;
- sync: the newest of main's commits whose `pubkit sync --check` step ran, in main.yml or
  in the merge queue's run of that very commit (main skips the tests the queue passed):
  pass or fail, with that run.

Each is one row (observed_at, repository, check, status pass|behind|fail|unknown, pinned, latest,
main_commit, run_url, fix, run_started_at), all of them one Avro file in the tenant's
buffer (inbox/pubkit-checks/), which the integrations ingest pod loads into BigQuery's
platform.pubkit_checks, where observability's pubkit_drift rule reads them. The schema is
integrations' PUBKIT_CHECK_SCHEMA. It writes as the GitHub Actions job's OpenID Connect
token, for the audience that is the URL's host name.

It prints only how many rows it wrote and how many failed: the state names private
repositories, and this runs in a public repository, so their names go only to the
private tenant, never to the log.
"""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

import fastavro

PIN = re.compile(r"/pubkit-(\d+\.\d+\.\d+)-py3-none-any\.whl")
# The names pubkit's generated CI gives the step that runs `pubkit sync --check`: the
# Python and Rust jobs' run lines, the service checks job's name, and the Node test
# job's first line.
SYNC_STEPS = ("pubkit sync --check", "make sync-check", "managed files are in step",
              "Run python -m venv .venv")
FOLDER = "inbox/pubkit-checks/"
# Named, as pubfleet board-publish is: Cloudflare, in front of storage, turns away
# Python's default User-Agent (error code 1010) before storage sees the request.
AGENT = "release-controlplane-pubkit-facts"
BUMP = "`git latest && ./pubkit bump`, then open its PR"
GOVERNED = "its nightly update PR moves it"
SYNC = "`git latest && ./pubkit sync`, then open its PR"
# How long a repository may stay behind a pubkit release before its pin fails.
GRACE_DAYS = 7
# How far back main's commits are read for a run whose sync check ran.
SYNC_RUNS = 10
_TIME = {"type": "long", "logicalType": "timestamp-micros"}
# integrations' PUBKIT_CHECK_SCHEMA, the columns of platform.pubkit_checks.
SCHEMA = fastavro.parse_schema({
    "type": "record", "name": "pubkit_check", "fields": [
        {"name": "observed_at", "type": _TIME},
        {"name": "repository", "type": "string"},
        {"name": "check", "type": "string"},
        {"name": "status", "type": "string"},
        {"name": "pinned", "type": "string"},
        {"name": "latest", "type": "string"},
        {"name": "main_commit", "type": "string"},
        {"name": "run_url", "type": "string"},
        {"name": "fix", "type": "string"},
        {"name": "run_started_at", "type": _TIME},
    ]})


def gh(path: str, raw: bool = False):
    """One GitHub API answer through gh, or None when it fails."""
    argv = ["gh", "api", path]
    if raw:
        argv[2:2] = ["-H", "Accept: application/vnd.github.raw+json"]
    proc = subprocess.run(argv, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        return None
    return proc.stdout if raw else json.loads(proc.stdout or "null")


def version(text: str) -> tuple[int, ...]:
    return tuple(int(p) for p in text.split("."))


def releases() -> dict[str, datetime]:
    """When each pubkit release was published, by version."""
    found = gh("repos/Sustenaut/pubkit/releases?per_page=100") or []
    return {r["tag_name"].removeprefix("v"): datetime.fromisoformat(r["published_at"].replace("Z", "+00:00"))
            for r in found if r.get("published_at") and not r.get("draft")}


def pin_row(repo: str, roles: dict, latest: str, published: dict[str, datetime], now: datetime) -> dict:
    """The pubkit the repository pins, against pubkit's releases: behind for GRACE_DAYS
    after the first release past its pin, failing after that."""
    text = gh(f"repos/{repo}/contents/tests/requirements-pubkit.txt", raw=True)
    m = PIN.search(text or "")
    if not m:
        return {"check": "pin", "status": "unknown", "pinned": "", "fix": ""}
    pinned = m.group(1)
    if version(pinned) >= version(latest):
        return {"check": "pin", "status": "pass", "pinned": pinned, "fix": ""}
    newer = [at for v, at in published.items() if re.fullmatch(r"\d+\.\d+\.\d+", v) and version(v) > version(pinned)]
    overdue = not newer or (now - min(newer)).days >= GRACE_DAYS
    return {"check": "pin", "status": "fail" if overdue else "behind", "pinned": pinned,
            "fix": GOVERNED if roles.get("govern") else BUMP}


def sync_step(repo: str, run: dict) -> str | None:
    """The run's sync check step's conclusion, success or failure, or None when it has
    none that ran."""
    jobs = gh(f"repos/{repo}/actions/runs/{run['id']}/jobs?per_page=100") or {}
    found = [s.get("conclusion") for job in jobs.get("jobs", []) for s in job.get("steps") or []
             if any(name in s.get("name", "") for name in SYNC_STEPS)]
    return "failure" if "failure" in found else "success" if "success" in found else None


def sync_row(repo: str) -> dict:
    """The newest of main's commits whose sync check ran: its result, commit and run.
    main.yml skips its tests on a commit the merge queue already passed, so a commit's
    other runs (the queue's, on that very commit) are read too, newest commit first."""
    runs = gh(f"repos/{repo}/actions/workflows/main.yml/runs?branch=main&status=completed&per_page={SYNC_RUNS}")
    for main_run in (runs or {}).get("workflow_runs") or []:
        sha = main_run.get("head_sha", "")
        others = gh(f"repos/{repo}/actions/runs?head_sha={sha}&status=completed&per_page=20") or {}
        for run in [main_run, *(r for r in others.get("workflow_runs") or [] if r["id"] != main_run["id"])]:
            if (found := sync_step(repo, run)) is not None:
                status = "fail" if found == "failure" else "pass"
                return {"check": "sync", "status": status, "main_commit": sha,
                        "run_url": run.get("html_url", ""), "fix": SYNC if status == "fail" else ""}
    return {"check": "sync", "status": "unknown", "main_commit": "", "run_url": "", "fix": ""}


def rows(state: dict, latest: str, published: dict[str, datetime], now: datetime,
         started: datetime) -> list[dict]:
    """Two rows for each repository on the board: its pin and its sync check. Only the
    sync row carries main's run and commit, the evidence of that check alone."""
    out = []
    for name, roles in sorted(state["repos"].items()):
        if not roles.get("board"):
            continue
        repo = f"{state['owner']}/{name}"
        pin = pin_row(repo, roles, latest, published, now)
        sync = sync_row(repo)
        for found in ({"main_commit": "", "run_url": "", **pin}, sync):
            out.append({"observed_at": now, "repository": repo, "latest": latest,
                        "pinned": pin["pinned"], **found, "run_started_at": started})
    return out


def encode(found: list[dict]) -> bytes:
    """The rows as one file; the same rows always give the same bytes."""
    out = io.BytesIO()
    marker = hashlib.sha256(repr(sorted(map(repr, found))).encode()).digest()[:16]
    fastavro.writer(out, SCHEMA, found, codec="deflate", sync_marker=marker)
    return out.getvalue()


def place(started: datetime, data: bytes) -> str:
    """Where the file goes in the tenant's buffer, one per run."""
    return f"{FOLDER}{started:%Y-%m-%d}/{started:%H%M%S}-nightly-{hashlib.sha256(data).hexdigest()[:16]}.avro"


def oidc_token(audience: str) -> str:
    url = os.environ["ACTIONS_ID_TOKEN_REQUEST_URL"]
    separator = "&" if "?" in url else "?"
    request = urllib.request.Request(f"{url}{separator}audience={urllib.parse.quote(audience)}", headers={
        "Authorization": f"Bearer {os.environ['ACTIONS_ID_TOKEN_REQUEST_TOKEN']}"})
    with urllib.request.urlopen(request, timeout=30) as response:  # noqa: S310 - GitHub's own address
        return json.load(response)["value"]


class Refused(Exception):
    """Storage would not take the file: its status, and what it said."""


def put(url: str, tenant: str, name: str, data: bytes) -> None:
    token = oidc_token(urllib.parse.urlsplit(url).hostname)
    request = urllib.request.Request(f"{url.rstrip('/')}/{tenant}/{name}", data=data, method="PUT",
                                     headers={"Authorization": f"Bearer {token}",
                                              "Content-Type": "application/octet-stream",
                                              "User-Agent": AGENT})
    try:
        with urllib.request.urlopen(request, timeout=60):  # noqa: S310 - the caller's --url
            pass
    except urllib.error.HTTPError as e:
        # Storage's answer names the principal and the tenant, never a repository.
        said = e.read().decode("utf-8", "replace")[:300]
        raise Refused(f"storage answered {e.code} for tenant {tenant}: {said}") from None


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="pubkit-facts")
    p.add_argument("state", type=Path)
    p.add_argument("--url")
    p.add_argument("--tenant")
    p.add_argument("--out", type=Path, help="write the file here instead of to storage")
    args = p.parse_args(argv)
    if not args.out and not (args.url and args.tenant):
        p.error("give --url and --tenant, or --out")
    state = json.loads(args.state.read_text(encoding="utf-8"))
    release = gh("repos/Sustenaut/pubkit/releases/latest")
    if not release:
        print("pubkit-facts: pubkit's latest release can't be read", file=sys.stderr)
        return 2
    now = datetime.now(timezone.utc)
    started = now.replace(microsecond=0)
    found = rows(state, release["tag_name"].removeprefix("v"), releases(), now, started)
    data = encode(found)
    if args.out:
        args.out.write_bytes(data)
    else:
        try:
            put(args.url, args.tenant, place(started, data), data)
        except Refused as e:
            print(f"pubkit-facts: {e}", file=sys.stderr)
            return 1
    failed = sum(1 for r in found if r["status"] == "fail")
    print(f"{len(found)} checks written, {failed} failing")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
